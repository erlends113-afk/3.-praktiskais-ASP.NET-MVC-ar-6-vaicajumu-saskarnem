@model List<EfWebDatabaseApp.Models.Book>
@{ ViewData["Title"] = "1. Vaicājums - Meklēt grāmatu"; }

<h2>1. Grāmatu meklēšana pēc nosaukuma fragmenta</h2>
<form method="get" class="row g-2 my-3">
    <div class="col-auto">
        <input type="text" name="keyword" class="form-control" placeholder="Ievadiet nosaukumu vai daļu..." value="@ViewBag.Keyword" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Meklēt</button>
        <a asp-action="Query1" class="btn btn-outline-secondary">Notīrīt</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr><th>ID</th><th>Nosaukums</th><th>Autors</th><th>Cena</th></tr>
    </thead>
    <tbody>
        @foreach (var book in Model) {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.Author?.Name</td>
                <td>@book.Price.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary mt-3">← Atpakaļ uz izvēlni</a>