@model List<EfWebDatabaseApp.Models.Book>
@{ ViewData["Title"] = "4. Vaicājums - TOP 3 dārgākās"; }

<h2>4. Sistēmas TOP 3 dārgākās grāmatas</h2>
<p class="text-muted">Automātisks vaicājums (OrderByDescending + Take 3)</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr><th>#</th><th>Grāmatas nosaukums</th><th>Autors</th><th>Cena</th></tr>
    </thead>
    <tbody>
        @{ int i = 1; }
        @foreach (var b in Model) {
            <tr>
                <td>@(i++)</td>
                <td>@b.Title</td>
                <td>@b.Author?.Name</td>
                <td class="text-success font-weight-bold">@b.Price.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary mt-3">← Atpakaļ uz izvēlni</a>